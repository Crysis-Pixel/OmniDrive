# ========================================================
# OmniDrive Environment Configuration
# ========================================================

# Application Mode
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# Database (PostgreSQL)
# On Render: Provide Render PostgreSQL internal or external connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnidrive"

# Redis & Queue (BullMQ)
# On Render: Provide Render Redis/KeyDB connection string
# If not available locally, in-memory job runner automatically activates
REDIS_URL="redis://localhost:6379"

# Security & Secrets
# SESSION_SECRET: String used to sign and verify session JWTs (at least 32 chars)
SESSION_SECRET="omnidrive_super_secure_session_secret_key_minimum_32_chars"

# TOKEN_ENCRYPTION_KEY: Exactly 32 bytes base64-encoded string for AES-256-GCM token encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="

# Google Cloud OAuth 2.0 Credentials
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/accounts/callback"
GOOGLE_SCOPES="https://www.googleapis.com/auth/drive"

# Drive & Sync Tuning
UPLOAD_CHUNK_BYTES=8388608
SYNC_INTERVAL_SECONDS=120

# Single-Service / Render Production Flag
# Set SERVE_STATIC=true when deploying as a combined service on Render so API serves React web build
SERVE_STATIC=false

# Demo Mode & Fake Drive
# When enabled, users can test with simulated multi-account Google Drives without Google credentials
ENABLE_DEMO_ACCOUNTS=true
